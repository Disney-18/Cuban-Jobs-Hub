# ============================================================
# cu_JobsHub - .gitignore
# Archivos y carpetas que NO se suben a GitHub
# ============================================================

# ============================================================
# SISTEMAS OPERATIVOS
# ============================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp

# Linux
*.tmp
*.swp
*.swo
*~

# ============================================================
# EDITORES Y ENTORNOS DE DESARROLLO
# ============================================================

# VS Code
.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ / WebStorm / PhpStorm
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Atom
.atom/
.config/
*.atom

# Vim
*.swp
*.swo
*~
.*.swp
.*.swo

# ============================================================
# DEPENDENCIAS Y BUILD
# ============================================================

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
*.cover
.hypothesis/
.python-version

# Ruby
*.gem
*.rbc
/.bundle/
/vendor/bundle/
/lib/bundler/man/
Gemfile.lock

# PHP
composer.phar
/vendor/
*.lock

# ============================================================
# ARCHIVOS DE LOG Y TEMPORALES
# ============================================================

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.cache
*.cached

# ============================================================
# ARCHIVOS SENSIBLES Y DE CONFIGURACIÓN
# ============================================================

# Environment variables
.env
.env.local
.env.*.local
.env.production
.env.development

# Secrets
*.pem
*.key
*.crt
*.p12
*.pfx
*.csr

# Authentication
.htpasswd
.htaccess
.ftpconfig
.remote-sync.json

# ============================================================
# ARCHIVOS DE RESPALDO
# ============================================================

*.bak
*.backup
*.old
*.orig
*.rej

# ============================================================
# ARCHIVOS DE PROYECTO ESPECÍFICOS
# ============================================================

# Docker
docker-compose.override.yml
*.dockerignore
!Dockerfile

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# ============================================================
# ARCHIVOS QUE SÍ SE SUBEN (ejemplos)
# ============================================================

# Estos archivos SÍ se suben a GitHub:
# !index.html
# !README.md
# !LICENSE
# !.gitignore
# !css/styles.css
# !js/app.js
# !data/oportunidades.json
# !scripts/validate.js
# !.github/workflows/*.yml
